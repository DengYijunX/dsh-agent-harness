{
  "name": "dsh-agent-harness",
  "version": "0.1.0",
  "private": false,
  "description": "A modular TypeScript Agent Harness built on DeepSeek Harness (DSH).",
  "license": "MIT",
  "main": "./dist/cli.js",
  "bin": {
    "dsh-agent-harness": "./dist/cli.js"
  },
  "files": [
    "dist",
    "harness.yml",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "npm run test:deterministic && npm run test:real",
    "test:deterministic": "vitest run --exclude test/real-chain.integration.test.ts",
    "test:real": "vitest run test/real-chain.integration.test.ts",
    "test:all": "npm run test:deterministic && npm run test:real",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/cli.js",
    "release:check": "npm test && npm run typecheck && npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "file:vendor/cordis",
    "@deepseek-ai/cordis-plugin-include": "file:vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "file:vendor/loader",
    "@deepseek-ai/schemastery": "file:vendor/schemastery",
    "@deepseek-ai/cosmokit": "file:vendor/cosmokit",
    "@standard-schema/spec": "1.1.0",
    "js-yaml": "4.1.0"
  }
}
